#!/usr/bin/env bash
set -euo pipefail

BASE=/app/projetos
SRC="$BASE/repository"
STATE="$BASE/.deployed-sha"
LOG="$BASE/sync.log"
REPO_URL=https://github.com/mskpoeira/projetos.git
BRANCH=main
APP=projetos-app
CANDIDATE=projetos-candidate
NETWORK=projetos
BIND=${PROJETOS_BIND:-127.0.0.1:48080}

mkdir -p "$BASE"
exec 9>"$BASE/.sync.lock"
flock -n 9 || exit 0
exec >>"$LOG" 2>&1

if [ ! -d "$SRC/.git" ]; then
  rm -rf "$SRC"
  git clone --depth 1 --branch "$BRANCH" "$REPO_URL" "$SRC"
else
  git -C "$SRC" fetch --depth 1 origin "$BRANCH"
fi

NEW_SHA=$(git -C "$SRC" rev-parse "origin/$BRANCH")
OLD_SHA=$(cat "$STATE" 2>/dev/null || true)

if [ "$NEW_SHA" = "$OLD_SHA" ] && docker inspect "$APP" >/dev/null 2>&1; then
  if docker exec "$APP" wget -qO- http://127.0.0.1/healthz >/dev/null 2>&1; then
    exit 0
  fi
fi

git -C "$SRC" reset --hard "origin/$BRANCH"
IMAGE="projetos-app:$NEW_SHA"

docker network inspect "$NETWORK" >/dev/null 2>&1 || docker network create "$NETWORK" >/dev/null
docker build --pull=false -t "$IMAGE" "$SRC"

docker rm -f "$CANDIDATE" >/dev/null 2>&1 || true
docker run -d --name "$CANDIDATE" --restart no --network "$NETWORK" "$IMAGE" >/dev/null

for i in $(seq 1 30); do
  if docker exec "$CANDIDATE" wget -qO- http://127.0.0.1/healthz >/dev/null 2>&1; then
    break
  fi
  [ "$i" -lt 30 ] || { docker logs --tail 120 "$CANDIDATE"; exit 1; }
  sleep 1
done

OLD_IMAGE=$(docker inspect "$APP" --format '{{.Config.Image}}' 2>/dev/null || true)
docker rm -f "$APP" >/dev/null 2>&1 || true
docker rm -f "$CANDIDATE" >/dev/null 2>&1 || true

docker run -d --name "$APP" --restart always   --network "$NETWORK"   -p "$BIND:80"   "$IMAGE" >/dev/null

if ! docker exec "$APP" wget -qO- http://127.0.0.1/healthz >/dev/null 2>&1; then
  docker rm -f "$APP" >/dev/null 2>&1 || true
  if [ -n "$OLD_IMAGE" ]; then
    docker run -d --name "$APP" --restart always --network "$NETWORK" -p "$BIND:80" "$OLD_IMAGE" >/dev/null
  fi
  exit 1
fi

printf '%s
' "$NEW_SHA" > "$STATE"
docker tag "$IMAGE" projetos-app:latest
