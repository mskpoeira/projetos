#!/usr/bin/env bash
set -euo pipefail

BASE=/app/projetos
SRC="$BASE/repository"
STATE="$BASE/.deployed-sha"
LOG="$BASE/sync.log"
REPO_URL=https://github.com/mskpoeira/projetos.git
BRANCH=main
APP=projetos-app
CANDIDATE=projetos-candidate
PROXY=sgr-proxy-prod

mkdir -p "$BASE"
exec 9>"$BASE/.sync.lock"
flock -n 9 || exit 0
exec >>"$LOG" 2>&1

echo "[$(date -Is)] Verificando atualizações do Portal de Projetos"

if [ ! -d "$SRC/.git" ]; then
  rm -rf "$SRC"
  git clone --depth 1 --branch "$BRANCH" "$REPO_URL" "$SRC"
else
  git -C "$SRC" fetch --depth 1 origin "$BRANCH"
fi

NEW_SHA=$(git -C "$SRC" rev-parse "origin/$BRANCH")
OLD_SHA=$(cat "$STATE" 2>/dev/null || true)

CURRENT_HEALTH="no"
if docker inspect "$APP" >/dev/null 2>&1 && docker exec "$APP" wget -qO- http://127.0.0.1/healthz >/dev/null 2>&1; then
  CURRENT_HEALTH="yes"
fi

if [ "$NEW_SHA" = "$OLD_SHA" ] && [ "$CURRENT_HEALTH" = "yes" ]; then
  echo "[$(date -Is)] Sem alterações: $NEW_SHA"
  exit 0
fi

git -C "$SRC" reset --hard "origin/$BRANCH"
IMAGE="projetos-app:$NEW_SHA"

echo "[$(date -Is)] Construindo $IMAGE"
docker build --pull=false -t "$IMAGE" "$SRC"

NETWORK=$(docker inspect -f '{{range $name, $cfg := .NetworkSettings.Networks}}{{println $name}}{{end}}' "$PROXY" 2>/dev/null | grep -Ev '^(bridge|host|none)$' | head -n 1 || true)
test -n "$NETWORK" || { echo "Rede do proxy não encontrada"; exit 1; }

docker rm -f "$CANDIDATE" >/dev/null 2>&1 || true
docker run -d --name "$CANDIDATE" --restart no --network "$NETWORK" --network-alias projetos-candidate "$IMAGE" >/dev/null

READY=no
for i in $(seq 1 30); do
  if docker exec "$CANDIDATE" wget -qO- http://127.0.0.1/healthz >/dev/null 2>&1; then
    READY=yes
    break
  fi
  sleep 1
done

if [ "$READY" != "yes" ]; then
  echo "Candidato não ficou saudável."
  docker logs --tail 120 "$CANDIDATE" || true
  docker rm -f "$CANDIDATE" >/dev/null 2>&1 || true
  exit 1
fi

OLD_IMAGE=$(docker inspect "$APP" --format '{{.Config.Image}}' 2>/dev/null || true)
docker rm -f "$APP" >/dev/null 2>&1 || true
docker network disconnect "$NETWORK" "$CANDIDATE" >/dev/null 2>&1 || true
docker network connect --alias projetos "$NETWORK" "$CANDIDATE"
docker rename "$CANDIDATE" "$APP"
docker update --restart always "$APP" >/dev/null

if ! docker exec "$APP" wget -qO- http://127.0.0.1/healthz >/dev/null 2>&1; then
  echo "Falha após a troca; tentando rollback."
  docker rm -f "$APP" >/dev/null 2>&1 || true
  if [ -n "$OLD_IMAGE" ]; then
    docker run -d --name "$APP" --restart always --network "$NETWORK" --network-alias projetos "$OLD_IMAGE" >/dev/null
  fi
  exit 1
fi

printf '%s\n' "$NEW_SHA" > "$STATE"
docker tag "$IMAGE" projetos-app:latest

echo "[$(date -Is)] Deploy concluído: $NEW_SHA"
